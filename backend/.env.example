# Copy this file to ".env" and fill in the values. NEVER commit ".env" to git.
# Lines starting with # are comments.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Behind a reverse proxy (Render, Railway, Nginx...) set this to 1 so rate limits
# see each visitor's real address.
# TRUST_PROXY=1
# Set to true to serve the API documentation at /api-docs (off in production by default).
# ENABLE_API_DOCS=true

# ---------------------------------------------------------------------------
# Your website
# ---------------------------------------------------------------------------
# The website's address. Used for CORS and for the links inside emails.
FRONTEND_URL=http://localhost:5173
# If the site has more than one address, list them here, separated by commas.
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Where the password-reset email sends people.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# ---------------------------------------------------------------------------
# Database and Supabase
# ---------------------------------------------------------------------------
# App connection: the Supabase transaction pooler (port 6543). It must end with
# ?pgbouncer=true, for example:
# postgresql://postgres.<project>:<password>@<host>:6543/postgres?pgbouncer=true&connect_timeout=60
DATABASE_URL=
# Used only by Prisma commands: the session pooler or direct connection (port 5432).
DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Needed for document uploads. This key can do ANYTHING in your project: keep it
# here on the server only, never in the frontend or in git.
SUPABASE_SERVICE_ROLE_KEY=
# DOCUMENT_BUCKET=verification-documents

# ---------------------------------------------------------------------------
# Reviews
# ---------------------------------------------------------------------------
# New reviews wait for a moderator unless this is false.
# REVIEWS_REQUIRE_MODERATION=true
# Hospital responses to reviews also wait for a moderator unless this is false.
# RESPONSES_REQUIRE_MODERATION=true

# ---------------------------------------------------------------------------
# Email (see README, section "Notifications and email")
# ---------------------------------------------------------------------------
# smtp = send through the server below (default) | log = print emails in this
# console instead of sending (use this until the domain and mailbox exist) |
# off = send nothing, emails wait in the queue
MAIL_MODE=log

# Your mail provider's SMTP details. Leave SMTP_HOST empty until you have them.
SMTP_HOST=
SMTP_PORT=587
# true only for port 465; leave false for 587.
SMTP_SECURE=false
# Usually the full mailbox address, e.g. noreply@hospitalreviewplatform.com
SMTP_USER=
# The mailbox password, or the SMTP key/app password your provider gives you.
SMTP_PASSWORD=
# true (recommended): refuse to send the login unencrypted.
SMTP_REQUIRE_TLS=true

# Who the emails come from. The address must belong to your own domain, and the
# domain must be verified with your mail provider.
MAIL_FROM_ADDRESS=noreply@hospitalreviewplatform.com
MAIL_FROM_NAME=Dreel
# Where replies go, if you want people to be able to reply (the From address is no-reply).
# MAIL_REPLY_TO=support@hospitalreviewplatform.com
# Shown in the suspension email as the place to ask for help.
# SUPPORT_EMAIL=support@hospitalreviewplatform.com
# The name shown at the top of emails and in the text.
APP_NAME=Dreel
# Set to off to stop the server sending queued emails itself (for example if you
# run `npm run send:emails` from a scheduler instead).
# MAIL_WORKER=on